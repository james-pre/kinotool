{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ES2022",
		"rootDir": "src",
		"outDir": "dist",
		"lib": ["ESNext", "ESNext.Disposable"],
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
